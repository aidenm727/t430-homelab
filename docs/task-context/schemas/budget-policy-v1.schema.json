{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aiden-platform:task-context:schema:budget-policy:v1",
  "title": "Aiden task-context budget policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "normative_unit",
    "limit_bytes",
    "allocation_order",
    "control_envelope_measurement",
    "mandatory_tier_overflow",
    "arbitrary_character_truncation",
    "digest"
  ],
  "properties": {
    "schema_version": {"const": "aiden.task-context.budget-policy/v1"},
    "id": {"const": "example.utf8-byte-budget"},
    "version": {"const": "1.0.0"},
    "normative_unit": {"const": "utf8_bytes"},
    "limit_bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "allocation_order": {
      "const": [
        "mandatory_control_envelope",
        "mandatory_authoritative_sources",
        "required_supporting_sources",
        "optional_evidence"
      ]
    },
    "control_envelope_measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalization", "remove"],
      "properties": {
        "canonicalization": {"const": "rfc8785-jcs"},
        "remove": {"const": ["package.digest", "payloads[*].content", "budget.measurement"]}
      }
    },
    "mandatory_tier_overflow": {"const": "non_consumable_budget_exceeded"},
    "arbitrary_character_truncation": {"const": "forbidden"},
    "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "value"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "canonicalization": {"const": "rfc8785-jcs"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
